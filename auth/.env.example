NODE_ENV=production

# Better Auth core
BETTER_AUTH_SECRET=replace-with-a-managed-production-secret
BETTER_AUTH_URL=https://auth.friink.com

# Dedicated Better Auth PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/friink_auth

# Browser origins permitted to use this auth service
AUTH_TRUSTED_ORIGINS=https://friink.com

# Shared with the apex app and Friink subdomains.
AUTH_COOKIE_DOMAIN=.friink.com

# Production email configuration; provider wiring is not implemented yet.
AUTH_EMAIL_DOMAIN=mail.friink.com
EMAIL_API_KEY=re_replace-with-managed-provider-key

# Better Auth session policy
AUTH_MAX_SESSIONS=4
AUTH_SESSION_EXPIRES_IN_DAYS=7
AUTH_SESSION_UPDATE_AGE_DAYS=1

# Email OTP policy
AUTH_OTP_ENABLED=true
AUTH_OTP_EXPIRES_IN_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESENT_LIMIT=3
AUTH_OTP_RESENT_IN_SECONDS=60
