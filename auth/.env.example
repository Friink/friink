# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://auth.friink.com
AUTH_COOKIE_DOMAIN=
# Comma-separated full origins allowed to call the auth service and receive validated return redirects.
# Include the accounts app and every other consuming product origin.
AUTH_TRUSTED_ORIGINS=https://friink.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/friink_auth

# Email delivery (Resend)
AUTH_EMAIL_DOMAIN=mail.friink.com
EMAIL_API_KEY=re_xxxxxxxxx

# Authentication behavior
AUTH_MAX_SESSIONS=4
AUTH_OTP_ENABLED=true
AUTH_OTP_EXPIRES_IN_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESENT_LIMIT=3
AUTH_OTP_RESENT_IN_SECONDS=60
