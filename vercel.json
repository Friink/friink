{
  "version": 2,
  "builds": [
    { "src": "web/package.json", "use": "@vercel/next" },
    { "src": "api/dist/api-handler.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "^/$", "dest": "/friink-site/index.html" },
    { "src": "/api/(.*)", "dest": "/api/dist/api-handler.js" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
