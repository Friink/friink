DATABASE_URL=
# Note: DATABASE_URL should be a standard postgresql:// URL. 
# The application automatically maps this URL to use SQLAlchemy with the psycopg3 driver.
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACTIVE_KID=default
# Optional JSON object of additional key ids to signing secrets for rotation.
JWT_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_REUSE_GRACE_SECONDS=60
# Set true only in an environment where Resend delivery is configured. When true,
# signup uses the neutral reservation + four-minute ownership-OTP flow.
SIGNUP_OTP_ENABLED=false
# Set true only when login-risk OTP delivery is configured.
LOGIN_RISK_OTP_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_DOMAIN=mail.friink.com
RESEND_FROM_NAME=Friink

# Local template only. Put staging R2 values in Vercel Preview, never in tracked files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Account-lifecycle timing is server-side only. Existing deletion requests keep
# their stored deadline if these values change later.
ACCOUNT_DELETION_GRACE_DAYS=32
ACCOUNT_DELETION_WARNING_DAYS=4
# Server-to-server secret for the internal lifecycle worker/recovery endpoints.
ACCOUNT_LIFECYCLE_INTERNAL_TOKEN=
MAX_REMEMBERED_ACCOUNTS_PER_DEVICE=5
